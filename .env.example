# Database — any PostgreSQL instance (Vercel Postgres / Neon / Supabase /
# Railway, or a local Postgres for development).
DATABASE_URL="postgresql://user:password@localhost:5432/yjmotorcycles"

# Admin login (used by prisma/seed.ts to create the first admin account).
ADMIN_USERNAME="youssef"
ADMIN_PASSWORD="change-this-password"

# Random 32+ char secret used to sign the admin session cookie.
SESSION_SECRET="change-this-to-a-long-random-string"

# WhatsApp number that appointment/inquiry messages are sent to (Egypt format).
WHATSAPP_NUMBER="201065173490"

# TikTok handle shown across the site (no @).
NEXT_PUBLIC_TIKTOK_USERNAME="YoussefJoe.rr"

# Optional — Vercel Blob storage token for image uploads in production.
# Without it, uploads are saved to /public/uploads locally.
BLOB_READ_WRITE_TOKEN=""

# Public site URL, used for SEO metadata / Open Graph / sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
