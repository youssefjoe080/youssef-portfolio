// Youssef Joe — Motorcycle Marketplace
// PostgreSQL datasource — works with any managed Postgres (Vercel Postgres /
// Neon / Supabase / Railway) or a self-hosted instance. See README for setup.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  NAKED
  SPORT
  ADVENTURE
  CRUISER
  OTHER
}

enum BikeCondition {
  EXCELLENT
  VERY_GOOD
  GOOD
  FAIR
}

enum LicenseStatus {
  LICENSED
  EXPIRED
  NOT_LICENSED
  IN_PROGRESS
}

enum BikeStatus {
  AVAILABLE
  RESERVED
  SOLD
  HIDDEN
}

enum AppointmentStatus {
  NEW
  CONTACTED
  INSPECTED
  CANCELLED
  SOLD
}

model Motorcycle {
  id       String @id @default(cuid())
  code     String @unique // YJ-001, YJ-002 ...
  slug     String @unique

  brand    String
  model    String
  year     Int
  category Category

  price   Int // EGP
  mileage Int // km
  engineCC Int? // displacement in cc, used for matcher + display

  condition BikeCondition

  licenseStatus      LicenseStatus
  licenseExpiry      DateTime?
  registrationOffice String?

  location String

  engineCondition      String
  paintCondition       String
  maintenanceCondition String
  modifications        String?

  description    String
  inspectionNotes String?

  // Private seller info — never exposed via public API/pages.
  ownerName  String?
  ownerPhone String?

  status BikeStatus @default(AVAILABLE)

  seoTitle       String?
  seoDescription String?

  images       BikeImage[]
  videoUrls    String? // JSON-encoded string[] of video URLs
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([brand])
}

model BikeImage {
  id       String  @id @default(cuid())
  bikeId   String
  bike     Motorcycle @relation(fields: [bikeId], references: [id], onDelete: Cascade)
  url      String
  order    Int     @default(0)
  isCover  Boolean @default(false)

  @@index([bikeId])
}

model Appointment {
  id String @id @default(cuid())

  bikeId String?
  bike   Motorcycle? @relation(fields: [bikeId], references: [id], onDelete: SetNull)

  // Snapshot fields so appointment history survives bike edits/deletion.
  bikeCode String
  bikeName String

  customerName  String
  customerPhone String
  preferredDate String // e.g. "2026-08-29"
  preferredTime String // e.g. "18:00"
  notes         String?

  status AppointmentStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([bikeId])
}

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String // bike_view | search | filter_use | matcher_use | whatsapp_click | appointment_booked | contact_click
  bikeId    String?
  bikeCode  String?
  meta      String? // JSON-encoded extra context
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model Counter {
  id    String @id
  value Int    @default(0)
}

model Admin {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
